{
  "name": "decks",
  "version": "2.0.0",
  "description": "Simple card deck app for playing TOKYO-NIGHTMARE.",
  "homepage": "https://github.com/hideishi-m/decks",
  "module": "index.mjs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.mjs"
    }
  },
  "scripts": {
    "start": "node --env-file=.env index.mjs",
    "test": "node --test",
    "redocly": "node node_modules/.bin/redocly build-docs swagger.yaml -o public/spec.html"
  },
  "author": "Hidenori ISHIKAWA",
  "files": [
    "*.mjs",
    "public/**/*.css",
    "public/**/*.html",
    "public/**/*.js",
    "public/**/*.svg"
  ],
  "license": "BSD-3-Clause",
  "config": {
    "ip": "127.0.0.1",
    "port": "8080"
  },
  "dependencies": {
    "debug": "^4.3.3",
    "express": "^4.17.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "proxy-addr": "^2.0.7",
    "svg-cards": "^4.0.0",
    "ws": "^8.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@redocly/cli": "^2.26.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1"
  }
}
